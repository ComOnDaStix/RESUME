# Original full-resolution images (use Assests/web/ optimized versions)
Assests/*.jpg
Assests/*.JPG
Assests/*.jpeg
Assests/*.JPEG
Assests/*.png
Assests/*.PNG

# Original videos (only the originals — compressed web versions in Assests/web/videos/ ARE committed)
Assests/*.mp4
Assests/*.MP4
Assests/*.mov
Assests/*.MOV
Assests/*.webm
!Assests/web/videos/*.mp4

# Duplicate poster folder (use Assests/web/posters instead)
Assests/posters/

# macOS / editor cruft
.DS_Store
**/.DS_Store
*.log
node_modules/

# Backup files
index.html.backup
*.bak
